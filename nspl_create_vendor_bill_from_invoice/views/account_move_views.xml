<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_form_inherit_vendor_bill" model="ir.ui.view">
        <field name="name">account.move.form.inherit.vendor.bill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add Generate Vendor Bill button -->
            <xpath expr="//header" position="inside">
                <button name="action_generate_vendor_bill"
                        type="object"
                        string="Generate Vendor Bill"
                        class="btn-primary"
                        attrs="{'invisible': ['|', ('move_type', '!=', 'out_invoice'), ('state', '!=', 'posted')]}"
                />
            </xpath>

            <!-- Add smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_open_related_vendor_bills"
                        class="oe_stat_button"
                        icon="fa-file-invoice-dollar"
                        attrs="{'invisible': [('related_vendor_bill_ids', '=', False)]}"
                >
                    <field string="Vendor Bills" name="related_vendor_bill_ids" widget="statinfo"/>
                </button>
            </xpath>

        </field>
    </record>

    <record id="view_account_move_form_inherit_show_vendor" model="ir.ui.view">
        <field name="name">account.move.form.inherit.show.vendor</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="vendor_id"/>
            </xpath>
        </field>
    </record>


</odoo>

